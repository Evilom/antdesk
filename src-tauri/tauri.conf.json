{
  "productName": "AntDesk",
  "version": "2.18.8",
  "identifier": "com.antdesk.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AntDesk",
        "url": "/index.html",
        "width": 400,
        "height": 600,
        "minWidth": 280,
        "minHeight": 400,
        "maxWidth": 600,
        "maxHeight": 900,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false
      },
      {
        "label": "pet",
        "title": "AntDesk Pet",
        "url": "/pet.html",
        "width": 200,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false
      },
      {
        "label": "fab-menu",
        "title": "AntDesk Menu",
        "url": "/menu.html",
        "width": 220,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "notepad",
        "title": "AntDesk Notepad",
        "url": "/notepad.html",
        "width": 280,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "quick",
        "title": "AntDesk Quick",
        "url": "/quick.html",
        "width": 300,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Evilom/antdesk/releases/download/updater/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4OUIzQUFBQThCMjIzODMKUldTREk3S29xanFiaU5MdmVDWG9sZVRNN3gva1AzYmRaS3VTQUdYYXQySzNWSE1FdzFPU0VrS1EK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
