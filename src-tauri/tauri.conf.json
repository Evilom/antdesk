{
  "productName": "AntDesk",
  "version": "2.5.2",
  "identifier": "com.antdesk.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "fab",
        "title": "AntDesk FAB",
        "url": "/fab.html",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "x": 100,
        "y": 100,
        "visible": true,
        "shadow": false
      },
      {
        "label": "main",
        "title": "AntDesk",
        "url": "/index.html",
        "width": 400,
        "height": 600,
        "minWidth": 280,
        "minHeight": 400,
        "maxWidth": 600,
        "maxHeight": 900,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false
      },
      {
        "label": "quick",
        "title": "AntDesk Quick",
        "url": "/quick.html",
        "width": 260,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Evilom/antdesk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4OUIzQUFBQThCMjIzODMKUldTREk3S29xanFiaU5MdmVDWG9sZVRNN3gva1AzYmRaS3VTQUdYYXQySzNWSE1FdzFPU0VrS1EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}